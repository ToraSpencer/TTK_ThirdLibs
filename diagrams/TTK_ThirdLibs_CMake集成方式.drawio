<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-11-26T00:00:00.000Z" agent="Claude" version="24.0.0">
  <diagram id="ttk-thirdlibs-cmake-usage" name="CMake 集成方式">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 整页背景 -->
        <mxCell id="p1-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1B2130;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="-40" y="-40" width="1540" height="850" as="geometry" />
        </mxCell>

        <mxCell id="title" value="TTK_ThirdLibs：两种 CMake 集成方式" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="方式 A 直接引用源码；方式 B 链接预编译静态库。来源：README.md §2.2–2.3、third_party/*/build_*.bat" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#AEB8C6;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="900" height="22" as="geometry" />
        </mxCell>

        <!-- 图例 -->
        <mxCell id="lg-a-sq" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#223247;strokeColor=#6C9BD1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="26" width="16" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg-a" value="方式 A：源码集成" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#AEB8C6;" vertex="1" parent="1">
          <mxGeometry x="1082" y="20" width="110" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lg-b-sq" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1C3A2A;strokeColor=#68D391;" vertex="1" parent="1">
          <mxGeometry x="1210" y="26" width="16" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg-b" value="方式 B：预编译" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#AEB8C6;" vertex="1" parent="1">
          <mxGeometry x="1232" y="20" width="100" height="28" as="geometry" />
        </mxCell>
        <mxCell id="lg-tip-sq" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3D3020;strokeColor=#F6C453;" vertex="1" parent="1">
          <mxGeometry x="1350" y="26" width="16" height="16" as="geometry" />
        </mxCell>
        <mxCell id="lg-tip" value="关键提示" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#AEB8C6;" vertex="1" parent="1">
          <mxGeometry x="1372" y="20" width="72" height="28" as="geometry" />
        </mxCell>

        <!-- 方式 A -->
        <mxCell id="colA" value="方式 A：add_subdirectory 源码集成（无需预编译）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fillColor=none;strokeColor=#6C9BD1;strokeWidth=2;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="660" height="560" as="geometry" />
        </mxCell>
        <mxCell id="aBoost" value="Boost 1.89.0&lt;br&gt;add_subdirectory(third_party/boost/boost1.89.0 EXCLUDE_FROM_ALL)&lt;br&gt;链接 Boost::geometry / Boost::serialization（需 170 个子模块）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#223247;strokeColor=#6C9BD1;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="155" width="600" height="80" as="geometry" />
        </mxCell>
        <mxCell id="aEigen" value="Eigen 3.4.0&lt;br&gt;add_subdirectory(third_party/eigen/eigen3.4.0 EXCLUDE_FROM_ALL)&lt;br&gt;链接 Eigen3::Eigen（INTERFACE，仅传播 include）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#223247;strokeColor=#6C9BD1;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="250" width="600" height="80" as="geometry" />
        </mxCell>
        <mxCell id="aOpenmesh" value="OpenMesh 7.0&lt;br&gt;add_subdirectory(third_party/openmesh/openmesh7.0 EXCLUDE_FROM_ALL)&lt;br&gt;嵌入式模式需手动传播 include 与 NOMINMAX / _USE_MATH_DEFINES" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#223247;strokeColor=#6C9BD1;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="345" width="600" height="80" as="geometry" />
        </mxCell>
        <mxCell id="aGtest" value="GTest 1.5.0&lt;br&gt;add_subdirectory(third_party/gtest EXCLUDE_FROM_ALL)&lt;br&gt;链接 gtest_main（包装工程保持 /MD，不产生 install）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#223247;strokeColor=#6C9BD1;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="440" width="600" height="80" as="geometry" />
        </mxCell>
        <mxCell id="aImgui" value="Dear ImGui 1.93.0&lt;br&gt;add_subdirectory(third_party/imgui EXCLUDE_FROM_ALL)&lt;br&gt;链接 imgui（Win32 + DX11，自动链 d3dcompiler）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#223247;strokeColor=#6C9BD1;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="535" width="600" height="80" as="geometry" />
        </mxCell>

        <!-- 方式 B -->
        <mxCell id="colB" value="方式 B：预编译静态库（install / debug_install）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fillColor=none;strokeColor=#68D391;strokeWidth=2;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="740" y="110" width="660" height="560" as="geometry" />
        </mxCell>
        <mxCell id="bBoost" value="Boost&lt;br&gt;include/ + libs/libboost_*.lib（+ cmake/）&lt;br&gt;按配置选择 install 或 debug_install 下的库" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#1C3A2A;strokeColor=#68D391;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="770" y="155" width="600" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bEigen" value="Eigen&lt;br&gt;include/（header-only）&lt;br&gt;无需链接，只加 include 目录" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#1C3A2A;strokeColor=#68D391;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="770" y="250" width="600" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bOpenmesh" value="OpenMesh&lt;br&gt;OpenMeshCore.lib / OpenMeshTools.lib&lt;br&gt;Debug 目录为 OpenMeshCored.lib / OpenMeshToolsd.lib" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#1C3A2A;strokeColor=#68D391;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="770" y="345" width="600" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bGtest" value="GTest&lt;br&gt;include/ + gtest.lib / gtest_main.lib&lt;br&gt;Release 与 Debug 同名，靠目录区分（/MD 与 /MDd）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#1C3A2A;strokeColor=#68D391;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="770" y="440" width="600" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bImgui" value="Dear ImGui&lt;br&gt;include/（含 backends/）+ imgui.lib&lt;br&gt;Release 与 Debug 同名，靠目录区分" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#1C3A2A;strokeColor=#68D391;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="770" y="535" width="600" height="80" as="geometry" />
        </mxCell>

        <!-- 底部提示 -->
        <mxCell id="tip" value="二选一：源码集成无需预编译，但每次配置都会编译，适合只依赖个别库；预编译集成需先执行 build_all_*.bat，配置更快、版本更可控，适合多个工程复用" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#3D3020;strokeColor=#F6C453;fontColor=#FFFFFF;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1320" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
