        </mxCell>
        <mxCell id="scPerLib" value="每个库一对脚本（third_party/&amp;lt;lib&amp;gt;/）&lt;br&gt;build_release1.89.0.bat / build_debug1.89.0.bat&lt;br&gt;CMake + VS 2022 → x64 静态库（/MD 或 /MDd）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#3D3020;strokeColor=#F6C453;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
