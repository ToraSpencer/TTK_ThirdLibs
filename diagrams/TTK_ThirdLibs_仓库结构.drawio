        <mxCell id="scFetch" value="拉取与维护&lt;br&gt;完整拉取所有第三方库.bat / _fetch_all_test.bat&lt;br&gt;gitPull.bat、gitACP.bat、.gitmodules&lt;br&gt;Boost 嵌套子模块需递归浅克隆" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#3D3020;strokeColor=#F6C453;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
