        <mxCell id="scAll" value="根脚本 build_all_release.bat / build_all_debug.bat&lt;br&gt;按序调用 5 个库；单个失败不中断，结束汇总" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#3D3020;strokeColor=#F6C453;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
