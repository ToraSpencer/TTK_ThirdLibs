        <mxCell id="scWrapper" value="包装工程（补齐上游缺失）&lt;br&gt;third_party/gtest/CMakeLists.txt — 保持 /MD&lt;br&gt;third_party/imgui/CMakeLists.txt — Win32 + DX11" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#3D3020;strokeColor=#F6C453;fontColor=#FFFFFF;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
